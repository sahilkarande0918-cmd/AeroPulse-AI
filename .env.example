# AeroPulse AI environment. Copy to .env and adjust. Never commit .env.
APP_ENV=development            # development | production (production requires JWT_SECRET_KEY)
# Primary hosted database: Neon PostgreSQL. Paste the connection string from the Neon console
# (Connection details -> include ?sslmode=require). postgres:// and postgresql:// are both accepted.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/aeropulse?sslmode=require
# Offline / on-premise: local PostgreSQL from docker-compose.yml (no internet needed):
# DATABASE_URL=postgresql+psycopg://aeropulse:SAME_AS_POSTGRES_PASSWORD@localhost:5432/aeropulse
# Unset: SQLite file backend/aeropulse_dev.db (quick local development and tests only).
JWT_SECRET_KEY=                # long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
DEMO_PASSWORD=                 # password for seeded demo users admin/officer/technician/analyst (random if empty)
POSTGRES_PASSWORD=             # used by docker-compose.yml
# Optional, off by default. Enabling sends synthetic structured results to Google's Gemini API.
LLM_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional overrides
# MODEL_PATH=ml/artifacts/rul_model.joblib
# DATA_DIRECTORY=ml/data/raw
MAX_UPLOAD_BYTES=5000000
# Organisation SSO (optional). AUTH_MODE=oidc validates IdP-signed bearer tokens and disables local passwords.
AUTH_MODE=local                # local | oidc
OIDC_ISSUER=                   # e.g. https://sso.example.org/realms/aeropulse
OIDC_AUDIENCE=                 # client id / audience expected in the token
OIDC_JWKS_URL=                 # e.g. https://sso.example.org/realms/aeropulse/protocol/openid-connect/certs
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
OIDC_ROLE_MAP=                 # idp-group=role pairs, e.g. mro-admins=admin,mro-officers=officer,mro-techs=technician,mro-analysts=analyst
